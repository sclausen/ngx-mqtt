{
  "name": "ngx-mqtt-workspace",
  "version": "17.0.0",
  "private": true,
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-mqtt && cp README.md LICENSE dist/ngx-mqtt/",
